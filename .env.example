# Server Port
PORT=3000

# Supabase Credentials (optional - falls back to local database if blank)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Twilio Configuration (optional - logs to console if blank)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=

# SMTP Email Configuration (optional - logs to console if blank)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=

# LLM API Keys for AI Distress Detection & Message Drafting (optional - falls back to mock regex keyword matching if blank)
GEMINI_API_KEY=
OPENAI_API_KEY=
